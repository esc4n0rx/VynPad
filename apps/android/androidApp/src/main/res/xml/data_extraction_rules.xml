<?xml version="1.0" encoding="utf-8"?>
<!-- O VynPad não faz backup na nuvem nem transfere dados entre aparelhos: o pareamento fica
     preso ao Keystore deste aparelho e as imagens de fundo são privadas do usuário. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
