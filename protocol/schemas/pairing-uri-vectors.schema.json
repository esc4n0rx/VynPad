{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padgaming.local/schemas/pairing-uri-vectors.schema.json",
  "title": "Test vectors da URI de pareamento (protocol/test-vectors/pairing-uri.json)",
  "description": "PROTOCOLO.md §4.2 e §11.",
  "type": "object",
  "required": ["format", "description", "vectors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "description": { "type": "string" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "uri", "expect"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": { "type": "string" },
          "uri": { "type": "string" },
          "expect": {
            "oneOf": [
              {
                "type": "object",
                "required": ["result", "params"],
                "additionalProperties": false,
                "properties": {
                  "result": { "const": "ok" },
                  "params": {
                    "type": "object",
                    "required": [
                      "version",
                      "hosts",
                      "port",
                      "fingerprint_hex",
                      "pairing_token_hex",
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "version": { "const": 1 },
                      "hosts": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "string" }
                      },
                      "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "fingerprint_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "pairing_token_hex": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                      "name": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["result", "error"],
                "additionalProperties": false,
                "properties": {
                  "result": { "const": "error" },
                  "error": {
                    "enum": ["bad_scheme", "missing_param", "bad_param", "unsupported_version"]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
